{
  "name": "agentos-sdk-ts",
  "version": "2.0.0",
  "description": "TypeScript SDK for AgentOS APIs and clients.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentos-org/agentos-sdk-ts.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./opentool": {
      "types": "./dist/opentool.d.ts",
      "import": "./dist/opentool.js",
      "require": "./dist/opentool.cjs",
      "default": "./dist/opentool.js"
    },
    "./third_party": {
      "types": "./dist/third_party.d.ts",
      "import": "./dist/third_party.js",
      "require": "./dist/third_party.cjs",
      "default": "./dist/third_party.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README-zh_CN.md"
  ],
  "scripts": {
    "build": "rollup -c --forceExit",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test ./test/sdk.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint \"src/**/*.ts\" \"test/typecheck/**/*.ts\"",
    "verify": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "eslint": "^10.8.0",
    "rollup": "^4.40.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "opentool-ts": "2.0.2"
  }
}
